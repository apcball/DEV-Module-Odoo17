# ============================================
# Monitor Website Backend - Environment Variables
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monitor_website
DB_USER=postgres
DB_PASSWORD=your_password_here

# Database URL (optional - ใช้แทนการ config ด้านบน)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/monitor_website

# ============================================
# Telegram Bot Configuration
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# วิธีรับ Token:
# 1. คุยกับ @BotFather บน Telegram
# 2. สร้าง bot ใหม่ด้วยคำสั่ง /newbot
# 3. นำ token มาใส่ที่นี่

# วิธีรับ Chat ID:
# 1. เพิ่ม bot เข้ากลุ่มหรือคุยกับ bot
# 2. ส่งข้อความอะไรก็ได้
# 3. เปิด URL: https://api.telegram.org/bot[TOKEN]/getUpdates
# 4. ดูค่า chat.id ใน response

# ============================================
# Monitoring Configuration
# ============================================
# ระยะเวลาเช็ค (นาที) - default 60
CHECK_INTERVAL_MINUTES=60

# Timeout สำหรับ request (วินาที)
REQUEST_TIMEOUT_SECONDS=30

# จำนวน retries ก่อนถือว่า down
MAX_RETRIES=3

# ระยะเวลาห่างระหว่าง retries (วินาที)
RETRY_DELAY_SECONDS=5

# ============================================
# Notification Settings
# ============================================
# ส่งแจ้งเตือนซ้ำทุกกี่นาที ถ้ายัง down อยู่
NOTIFICATION_REPEAT_MINUTES=60

# เปิด/ปิดการแจ้งเตือน
ENABLE_TELEGRAM_NOTIFICATIONS=true

# ============================================
# CORS Configuration
# ============================================
# อนุญาตให้ frontend ที่ origin ไหนเข้าถึงได้
CORS_ORIGIN=http://localhost:3000

# หรืออนุญาตทุก origin (ไม่แนะนำใน production)
# CORS_ORIGIN=*