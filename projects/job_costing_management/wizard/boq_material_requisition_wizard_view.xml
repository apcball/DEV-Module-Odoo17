<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Wizard Form - Dynamic based on state -->
    <record id="view_boq_material_requisition_wizard_form" model="ir.ui.view">
        <field name="name">boq.material.requisition.wizard.form</field>
        <field name="model">boq.material.requisition.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Material Requisition from BOQ">
                <field name="wizard_state" invisible="1"/>
                <field name="filter_version" invisible="1"/>
                
                <!-- Selection View -->
                <div invisible="wizard_state != 'selection'">
                    <sheet>
                        <div class="oe_title mb-3">
                            <h1 class="d-flex align-items-center">
                                <span class="me-2">📦</span>
                                <span>Material Requisition Wizard</span>
                            </h1>
                        </div>
                        
                        <!-- BOQ Info -->
                        <div class="row mb-3 bg-light p-3 rounded">
                            <div class="col-md-3">
                                <span class="small text-muted">BOQ</span>
                                <div class="fw-bold"><field name="boq_id" readonly="1"/></div>
                            </div>
                            <div class="col-md-3">
                                <span class="small text-muted">Project</span>
                                <div><field name="project_id" readonly="1"/></div>
                            </div>
                            <div class="col-md-3">
                                <span class="small text-muted">Job Order</span>
                                <div><field name="job_order_id" readonly="1"/></div>
                            </div>
                            <div class="col-md-3">
                                <span class="small text-muted">Job Cost Sheet</span>
                                <div><field name="job_cost_sheet_id" readonly="1"/></div>
                            </div>
                        </div>
                        
                        <!-- Requisition Details -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <field name="purpose" placeholder="Purpose/Reason for requisition..." required="1"/>
                            </div>
                            <div class="col-md-3">
                                <field name="required_date" required="1"/>
                            </div>
                            <div class="col-md-3">
                                <field name="priority"/>
                            </div>
                        </div>
                        
                        <!-- Search and Filters -->
                        <div class="card mb-3">
                            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                                <strong>🔍 Search & Filter</strong>
                                <button name="action_clear_filters" string="Clear Filters" type="object" 
                                        class="btn btn-sm btn-light" icon="fa-times"/>
                            </div>
                            <div class="card-body">
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label for="search_term" class="small text-muted">Search Products</label>
                                        <field name="search_term" 
                                               placeholder="Search by name or code..."
                                               class="form-control"/>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="category_filter" class="small text-muted">BOQ Category</label>
                                        <field name="category_filter" 
                                               options="{'no_create': True, 'no_open': True}"
                                               domain="[('boq_id', '=', boq_id)]"
                                               placeholder="Filter by category..."/>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="product_category_filter" class="small text-muted">Product Category</label>
                                        <field name="product_category_filter" 
                                               options="{'no_create': True, 'no_open': True}"
                                               placeholder="Filter by product category..."/>
                                    </div>
                                    <div class="col-md-2">
                                        <label for="cost_type_filter" class="small text-muted">Cost Type</label>
                                        <field name="cost_type_filter"/>
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-12 d-flex align-items-center">
                                        <label for="group_by" class="small text-muted me-3 mb-0">Group By:</label>
                                        <field name="group_by" widget="radio" options="{'horizontal': true}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Statistics Bar -->
                        <div class="alert alert-primary d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-4">
                                <span>Total: <field name="total_lines_count" readonly="1" class="fw-bold"/></span>
                                <span>Selected: <field name="selected_lines_count" readonly="1" class="fw-bold text-success"/></span>
                                <span>Qty: <field name="selected_total_quantity" readonly="1"/></span>
                                <span>Cost: <field name="selected_total_cost" widget="monetary" readonly="1" class="fw-bold"/></span>
                            </div>
                            <div>
                                <button name="action_select_all" string="Select All" type="object" 
                                        class="btn btn-sm btn-success me-1" icon="fa-check-square"/>
                                <button name="action_deselect_all" string="None" type="object" 
                                        class="btn btn-sm btn-outline-secondary" icon="fa-square-o"/>
                            </div>
                        </div>
                        
                        <!-- Lines - Filtered by display_in_wizard -->
                        <field name="line_ids" mode="tree" domain="[('display_in_wizard', '=', True)]">
                            <tree string="BOQ Lines" editable="bottom" 
                                  decoration-muted="quantity_status == 'complete'"
                                  decoration-warning="quantity_status == 'exceed'"
                                  decoration-success="selected == True"
                                  limit="100">
                                <field name="display_in_wizard" invisible="1"/>
                                <field name="selected" widget="boolean_toggle"/>
                                <field name="category_sequence" invisible="1"/>
                                <field name="category_name" invisible="1"/>
                                <field name="product_category_name" invisible="1"/>
                                <field name="product_id" options="{'no_create': True}" required="1"/>
                                <field name="description"/>
                                <field name="category_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                <field name="product_category_id" options="{'no_create': True, 'no_open': True}" optional="hide"/>
                                <field name="boq_quantity" readonly="1" optional="show"/>
                                <field name="requisitioned_quantity" readonly="1" optional="show"/>
                                <field name="remaining_quantity" readonly="1" optional="show"/>
                                <field name="requested_quantity" 
                                       decoration-warning="requested_quantity > remaining_quantity"/>
                                <field name="uom_id" options="{'no_create': True}" required="1" optional="show"/>
                                <field name="estimated_cost" optional="show"/>
                                <field name="total_cost" readonly="1" optional="show"/>
                                <field name="quantity_status" readonly="1" optional="show"/>
                                <field name="boq_line_id" invisible="1"/>
                                <field name="has_warning" invisible="1"/>
                            </tree>
                        </field>
                        
                        <div class="alert alert-info mt-3">
                            <small>
                                <strong>Tip:</strong> Use search and filters to find materials quickly. 
                                Toggle items to select. Yellow = exceeds BOQ quantity. Green = selected.
                            </small>
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_go_to_preview" string="Next: Review →" type="object" 
                                class="btn-primary" icon="fa-arrow-right"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </div>
                
                <!-- Preview View -->
                <div invisible="wizard_state != 'preview'">
                    <sheet>
                        <div class="oe_title mb-4">
                            <h1>✅ Review & Confirm</h1>
                            <p class="text-muted">Review your selection before creating the requisition</p>
                        </div>
                        
                        <!-- Summary Card -->
                        <div class="card mb-4">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">📊 Requisition Summary</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <table class="table table-sm table-borderless">
                                            <tr><td class="text-muted">BOQ:</td><td><field name="boq_id" readonly="1"/></td></tr>
                                            <tr><td class="text-muted">Project:</td><td><field name="project_id" readonly="1"/></td></tr>
                                            <tr><td class="text-muted">Purpose:</td><td><field name="purpose" readonly="1"/></td></tr>
                                        </table>
                                    </div>
                                    <div class="col-md-6">
                                        <table class="table table-sm table-borderless">
                                            <tr><td class="text-muted">Required Date:</td><td><field name="required_date" readonly="1"/></td></tr>
                                            <tr><td class="text-muted">Priority:</td><td><field name="priority" readonly="1"/></td></tr>
                                        </table>
                                    </div>
                                </div>
                                
                                <div class="row text-center bg-light p-3 rounded">
                                    <div class="col-md-4">
                                        <h3 class="text-primary mb-0"><field name="selected_lines_count" readonly="1"/></h3>
                                        <small class="text-muted">Items</small>
                                    </div>
                                    <div class="col-md-4">
                                        <h3 class="text-info mb-0"><field name="selected_total_quantity" readonly="1"/></h3>
                                        <small class="text-muted">Quantity</small>
                                    </div>
                                    <div class="col-md-4">
                                        <h3 class="text-success mb-0"><field name="selected_total_cost" widget="monetary" readonly="1"/></h3>
                                        <small class="text-muted">Est. Cost</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Selected Items -->
                        <h5 class="mb-3">Selected Items (<field name="selected_lines_count" readonly="1"/>)</h5>
                        <field name="line_ids" mode="tree" domain="[('selected', '=', True)]" readonly="1">
                            <tree string="Selected Items"
                                  decoration-warning="quantity_status == 'exceed'">
                                <field name="product_id"/>
                                <field name="description"/>
                                <field name="category_id"/>
                                <field name="boq_quantity"/>
                                <field name="requested_quantity"/>
                                <field name="uom_id"/>
                                <field name="estimated_cost"/>
                                <field name="total_cost" sum="Total"/>
                                <field name="quantity_status"/>
                            </tree>
                        </field>
                    </sheet>
                    <footer>
                        <button name="action_go_back_to_selection" string="← Back" type="object" 
                                class="btn-secondary" icon="fa-arrow-left"/>
                        <button name="action_create_requisition" string="✓ Create Requisition" type="object" 
                                class="btn-success btn-lg" icon="fa-check"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </div>
            </form>
        </field>
    </record>

    <!-- BOQ Material Requisition Wizard Action -->
    <record id="action_boq_material_requisition_wizard" model="ir.actions.act_window">
        <field name="name">Create Material Requisition</field>
        <field name="res_model">boq.material.requisition.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_boq_id': active_id}</field>
    </record>
</odoo>
