<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BOQ Material Requisition Wizard Form - Selection State -->
    <record id="view_boq_material_requisition_wizard_form_selection" model="ir.ui.view">
        <field name="name">boq.material.requisition.wizard.form.selection</field>
        <field name="model">boq.material.requisition.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Material Requisition from BOQ">
                <!-- Header with Progress -->
                <header>
                    <field name="wizard_state" widget="statusbar" 
                           statusbar_visible="selection,preview"
                           options="{'clickable': '0'}"/>
                </header>
                
                <sheet>
                    <!-- Title and Info Banner -->
                    <div class="oe_title mb-3">
                        <h1 class="d-flex align-items-center">
                            <span class="me-2">📦</span>
                            <span>Material Requisition Wizard</span>
                        </h1>
                    </div>
                    
                    <!-- BOQ Information Card -->
                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <strong>📋 BOQ Information</strong>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <field name="boq_id" readonly="1" class="fw-bold"/>
                                </div>
                                <div class="col-md-3">
                                    <field name="project_id" readonly="1"/>
                                </div>
                                <div class="col-md-3">
                                    <field name="job_order_id" readonly="1"/>
                                </div>
                                <div class="col-md-3">
                                    <field name="job_cost_sheet_id" readonly="1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Requisition Details -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <field name="purpose" placeholder="Enter purpose or reason for this requisition..." required="1"/>
                        </div>
                        <div class="col-md-4">
                            <field name="required_date" required="1"/>
                        </div>
                        <div class="col-md-4">
                            <field name="priority" widget="radio" options="{'horizontal': true}"/>
                        </div>
                    </div>
                    
                    <!-- Search and Filter Bar -->
                    <div class="card mb-3 border-info">
                        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                            <span><strong>🔍 Search &amp; Filter Materials</strong></span>
                            <button name="action_clear_filters" string="Clear All Filters" type="object" 
                                    class="btn btn-sm btn-light" icon="fa-times"/>
                        </div>
                        <div class="card-body bg-light">
                            <div class="row g-3">
                                <!-- Search Box -->
                                <div class="col-md-4">
                                    <label for="search_term" class="form-label">
                                        <i class="fa fa-search"/>
                                        Quick Search
                                    </label>
                                    <field name="search_term" 
                                           placeholder="Search by product name or code..."
                                           class="form-control"/>
                                    <small class="text-muted">Type to search product names, codes, or descriptions</small>
                                </div>
                                
                                <!-- Category Filter -->
                                <div class="col-md-3">
                                    <label for="category_filter" class="form-label">
                                        <i class="fa fa-folder"/>
                                        BOQ Category
                                    </label>
                                    <field name="category_filter" 
                                           options="{'no_create': True, 'no_open': True}"
                                           domain="[('boq_id', '=', boq_id)]"
                                           class="form-control"/>
                                </div>
                                
                                <!-- Product Category Filter -->
                                <div class="col-md-3">
                                    <label for="product_category_filter" class="form-label">
                                        <i class="fa fa-tags"/>
                                        Product Category
                                    </label>
                                    <field name="product_category_filter" 
                                           options="{'no_create': True, 'no_open': True}"
                                           class="form-control"/>
                                </div>
                                
                                <!-- Cost Type Filter -->
                                <div class="col-md-2">
                                    <label for="cost_type_filter" class="form-label">
                                        <i class="fa fa-filter"/>
                                        Cost Type
                                    </label>
                                    <field name="cost_type_filter" class="form-control"/>
                                </div>
                            </div>
                            
                            <!-- Group By Options -->
                            <div class="row mt-3">
                                <div class="col-12">
                                    <label for="group_by" class="form-label me-3">
                                        <i class="fa fa-object-group"/>
                                        <strong>Group By:</strong>
                                    </label>
                                    <field name="group_by" widget="radio" 
                                           options="{'horizontal': true}"
                                           class="d-inline"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Selection Statistics -->
                    <div class="alert alert-primary d-flex justify-content-between align-items-center mb-3" role="alert">
                        <div class="d-flex gap-4">
                            <span><strong>Total Items:</strong> <field name="total_lines_count" readonly="1"/></span>
                            <span><strong>Selected:</strong> <field name="selected_lines_count" readonly="1" class="fw-bold text-success"/></span>
                            <span><strong>Total Qty:</strong> <field name="selected_total_quantity" readonly="1"/></span>
                            <span><strong>Est. Cost:</strong> <field name="selected_total_cost" widget="monetary" readonly="1" class="fw-bold"/></span>
                        </div>
                        <div class="d-flex gap-2">
                            <button name="action_select_all" string="Select All Filtered" type="object" 
                                    class="btn btn-sm btn-success" icon="fa-check-square-o"/>
                            <button name="action_deselect_all" string="Deselect All" type="object" 
                                    class="btn btn-sm btn-outline-danger" icon="fa-square-o"/>
                        </div>
                    </div>
                    
                    <!-- BOQ Lines with Improved UX -->
                    <div class="o_list_view">
                        <field name="line_ids" mode="tree">
                            <tree string="BOQ Lines" editable="bottom" 
                                  decoration-muted="quantity_status == 'complete'"
                                  decoration-warning="quantity_status == 'exceed'"
                                  decoration-success="selected == True"
                                  limit="50">
                                
                                <!-- Selection Checkbox -->
                                <field name="selected" widget="boolean_toggle"/>
                                
                                <!-- Category Info (for grouping) -->
                                <field name="category_sequence" invisible="1"/>
                                <field name="category_name" invisible="1"/>
                                <field name="product_category_name" invisible="1"/>
                                
                                <!-- Product Information -->
                                <field name="product_id" options="{'no_create': True}" required="1"/>
                                <field name="description"/>
                                
                                <!-- Category Display -->
                                <field name="category_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                <field name="product_category_id" options="{'no_create': True, 'no_open': True}" optional="hide"/>
                                
                                <!-- Quantity Information -->
                                <field name="boq_quantity" readonly="1" optional="show"/>
                                <field name="requisitioned_quantity" readonly="1" optional="show"/>
                                <field name="remaining_quantity" readonly="1" optional="show"/>
                                
                                <!-- Requested Quantity with Warning -->
                                <field name="requested_quantity" 
                                       decoration-warning="requested_quantity > remaining_quantity"
                                       decoration-danger="requested_quantity &lt;= 0"/>
                                
                                <field name="uom_id" options="{'no_create': True}" required="1" optional="show"/>
                                
                                <!-- Cost Information -->
                                <field name="estimated_cost" optional="show"/>
                                <field name="total_cost" readonly="1" optional="show"/>
                                
                                <!-- Status -->
                                <field name="quantity_status" readonly="1" optional="show"
                                       decoration-success="quantity_status == 'within'"
                                       decoration-warning="quantity_status == 'exceed'"
                                       decoration-muted="quantity_status == 'complete'"/>
                                
                                <!-- Hidden Fields -->
                                <field name="boq_line_id" invisible="1"/>
                                <field name="has_warning" invisible="1"/>
                                <field name="sequence" invisible="1"/>
                            </tree>
                        </field>
                    </div>
                    
                    <!-- Info Box -->
                    <div class="alert alert-info mt-3" role="alert">
                        <h6 class="alert-heading"><i class="fa fa-info-circle"/> How to use this wizard:</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <ul class="mb-0 small">
                                    <li><strong>Search</strong> products using the search box above</li>
                                    <li><strong>Filter</strong> by BOQ category or product category</li>
                                    <li><strong>Select</strong> items using the toggle switches</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul class="mb-0 small">
                                    <li><strong>Edit quantities</strong> inline - defaults to remaining qty</li>
                                    <li><span class="text-warning">⚠️ Yellow rows</span> = Quantity exceeds BOQ</li>
                                    <li><span class="text-success">✅ Green rows</span> = Selected items</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </sheet>
                
                <!-- Footer with Action Buttons -->
                <footer>
                    <button name="action_go_to_preview" string="Review Selection →" type="object" 
                            class="btn-primary btn-lg" icon="fa-arrow-right"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- BOQ Material Requisition Wizard Form - Preview State -->
    <record id="view_boq_material_requisition_wizard_form_preview" model="ir.ui.view">
        <field name="name">boq.material.requisition.wizard.form.preview</field>
        <field name="model">boq.material.requisition.wizard</field>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Review and Create Material Requisition">
                <!-- Header with Progress -->
                <header>
                    <field name="wizard_state" widget="statusbar" 
                           statusbar_visible="selection,preview"
                           options="{'clickable': '0'}"/>
                </header>
                
                <sheet>
                    <!-- Title -->
                    <div class="oe_title mb-4">
                        <h1>📋 Review Material Requisition</h1>
                        <p class="text-muted">Please review your selection before creating the requisition</p>
                    </div>
                    
                    <!-- Requisition Summary Card -->
                    <div class="card mb-4 border-primary">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">📋 Requisition Summary</h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <table class="table table-borderless table-sm">
                                        <tr>
                                            <td class="text-muted">BOQ:</td>
                                            <td><field name="boq_id" readonly="1"/></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Project:</td>
                                            <td><field name="project_id" readonly="1"/></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Job Order:</td>
                                            <td><field name="job_order_id" readonly="1"/></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-borderless table-sm">
                                        <tr>
                                            <td class="text-muted">Required Date:</td>
                                            <td><field name="required_date" readonly="1"/></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Priority:</td>
                                            <td><field name="priority" readonly="1"/></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Purpose:</td>
                                            <td><field name="purpose" readonly="1"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            
                            <!-- Statistics Row -->
                            <div class="row bg-light p-3 rounded">
                                <div class="col-md-4 text-center border-end">
                                    <h2 class="text-primary mb-0">
                                        <field name="selected_lines_count" readonly="1"/>
                                    </h2>
                                    <small class="text-muted">Items Selected</small>
                                </div>
                                <div class="col-md-4 text-center border-end">
                                    <h2 class="text-info mb-0">
                                        <field name="selected_total_quantity" readonly="1"/>
                                    </h2>
                                    <small class="text-muted">Total Quantity</small>
                                </div>
                                <div class="col-md-4 text-center">
                                    <h2 class="text-success mb-0">
                                        <field name="selected_total_cost" widget="monetary" readonly="1"/>
                                    </h2>
                                    <small class="text-muted">Estimated Total Cost</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Selected Items List -->
                    <h4 class="mb-3">📝 Selected Items</h4>
                    <div class="o_list_view">
                        <field name="line_ids" mode="tree" domain="[('selected', '=', True)]" readonly="1">
                            <tree string="Selected Items" 
                                  decoration-warning="quantity_status == 'exceed'">
                                <field name="product_id"/>
                                <field name="description"/>
                                <field name="category_id" optional="show"/>
                                <field name="boq_quantity"/>
                                <field name="requisitioned_quantity"/>
                                <field name="requested_quantity"/>
                                <field name="uom_id"/>
                                <field name="estimated_cost"/>
                                <field name="total_cost" sum="Total"/>
                                <field name="quantity_status" 
                                       decoration-success="quantity_status == 'within'"
                                       decoration-warning="quantity_status == 'exceed'"/>
                            </tree>
                        </field>
                    </div>
                    
                    <!-- Warnings Section -->
                    <div class="alert alert-warning mt-4" role="alert" invisible="1">
                        <h6><i class="fa fa-exclamation-triangle"/> Warnings:</h6>
                        <ul>
                            <li>Some quantities exceed the remaining BOQ quantity</li>
                        </ul>
                    </div>
                </sheet>
                
                <!-- Footer -->
                <footer>
                    <button name="action_go_back_to_selection" string="← Back to Selection" type="object" 
                            class="btn-secondary" icon="fa-arrow-left"/>
                    <button name="action_create_requisition" string="✓ Create Requisition" type="object" 
                            class="btn-success btn-lg" icon="fa-check"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Main Wizard Form - Dynamic based on state -->
    <record id="view_boq_material_requisition_wizard_form" model="ir.ui.view">
        <field name="name">boq.material.requisition.wizard.form</field>
        <field name="model">boq.material.requisition.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Material Requisition from BOQ">
                <field name="wizard_state" invisible="1"/>
                
                <!-- Selection View -->
                <div invisible="wizard_state != 'selection'">
                    <sheet>
                        <div class="oe_title mb-3">
                            <h1 class="d-flex align-items-center">
                                <span class="me-2">📦</span>
                                <span>Material Requisition Wizard</span>
                            </h1>
                        </div>
                        
                        <!-- BOQ Info -->
                        <div class="row mb-3 bg-light p-3 rounded">
                            <div class="col-md-3">
                                <span class="small text-muted">BOQ</span>
                                <div class="fw-bold"><field name="boq_id" readonly="1"/></div>
                            </div>
                            <div class="col-md-3">
                                <span class="small text-muted">Project</span>
                                <div><field name="project_id" readonly="1"/></div>
                            </div>
                            <div class="col-md-3">
                                <span class="small text-muted">Job Order</span>
                                <div><field name="job_order_id" readonly="1"/></div>
                            </div>
                            <div class="col-md-3">
                                <span class="small text-muted">Job Cost Sheet</span>
                                <div><field name="job_cost_sheet_id" readonly="1"/></div>
                            </div>
                        </div>
                        
                        <!-- Requisition Details -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <field name="purpose" placeholder="Purpose/Reason for requisition..." required="1"/>
                            </div>
                            <div class="col-md-3">
                                <field name="required_date" required="1"/>
                            </div>
                            <div class="col-md-3">
                                <field name="priority"/>
                            </div>
                        </div>
                        
                        <!-- Search and Filters -->
                        <div class="card mb-3">
                            <div class="card-header bg-info text-white">
                                <strong>🔍 Search &amp; Filter</strong>
                                <button name="action_clear_filters" string="Clear Filters" type="object" 
                                        class="btn btn-sm btn-light float-end" icon="fa-times"/>
                            </div>
                            <div class="card-body">
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <field name="search_term" 
                                               placeholder="Search products..."
                                               class="form-control"/>
                                    </div>
                                    <div class="col-md-3">
                                        <field name="category_filter" 
                                               options="{'no_create': True}"
                                               domain="[('boq_id', '=', boq_id)]"
                                               placeholder="BOQ Category"/>
                                    </div>
                                    <div class="col-md-3">
                                        <field name="product_category_filter" 
                                               options="{'no_create': True}"
                                               placeholder="Product Category"/>
                                    </div>
                                    <div class="col-md-2">
                                        <field name="cost_type_filter"/>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <label for="group_by" class="small text-muted me-2">Group By:</label>
                                        <field name="group_by" widget="radio" options="{'horizontal': true}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Statistics Bar -->
                        <div class="alert alert-primary d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-4">
                                <span>Total: <field name="total_lines_count" readonly="1" class="fw-bold"/></span>
                                <span>Selected: <field name="selected_lines_count" readonly="1" class="fw-bold text-success"/></span>
                                <span>Qty: <field name="selected_total_quantity" readonly="1"/></span>
                                <span>Cost: <field name="selected_total_cost" widget="monetary" readonly="1" class="fw-bold"/></span>
                            </div>
                            <div>
                                <button name="action_select_all" string="Select All" type="object" 
                                        class="btn btn-sm btn-success me-1" icon="fa-check-square"/>
                                <button name="action_deselect_all" string="None" type="object" 
                                        class="btn btn-sm btn-outline-secondary" icon="fa-square-o"/>
                            </div>
                        </div>
                        
                        <!-- Lines -->
                        <field name="line_ids" mode="tree">
                            <tree string="BOQ Lines" editable="bottom" 
                                  decoration-muted="quantity_status == 'complete'"
                                  decoration-warning="quantity_status == 'exceed'"
                                  decoration-success="selected == True"
                                  limit="100">
                                <field name="selected" widget="boolean_toggle"/>
                                <field name="category_sequence" invisible="1"/>
                                <field name="category_name" invisible="1"/>
                                <field name="product_category_name" invisible="1"/>
                                <field name="product_id" options="{'no_create': True}" required="1"/>
                                <field name="description"/>
                                <field name="category_id" options="{'no_create': True, 'no_open': True}" optional="show"/>
                                <field name="product_category_id" options="{'no_create': True, 'no_open': True}" optional="hide"/>
                                <field name="boq_quantity" readonly="1"/>
                                <field name="requisitioned_quantity" readonly="1"/>
                                <field name="remaining_quantity" readonly="1"/>
                                <field name="requested_quantity" 
                                       decoration-warning="requested_quantity > remaining_quantity"/>
                                <field name="uom_id" options="{'no_create': True}" required="1"/>
                                <field name="estimated_cost"/>
                                <field name="total_cost" readonly="1"/>
                                <field name="quantity_status" readonly="1"/>
                                <field name="boq_line_id" invisible="1"/>
                                <field name="has_warning" invisible="1"/>
                            </tree>
                        </field>
                        
                        <div class="alert alert-info mt-3">
                            <small>
                                <strong>Tip:</strong> Use search and filters to find materials quickly. 
                                Toggle items to select. Yellow = exceeds BOQ quantity. Green = selected.
                            </small>
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_go_to_preview" string="Next: Review →" type="object" 
                                class="btn-primary" icon="fa-arrow-right"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </div>
                
                <!-- Preview View -->
                <div invisible="wizard_state != 'preview'">
                    <sheet>
                        <div class="oe_title mb-4">
                            <h1>✅ Review &amp; Confirm</h1>
                            <p class="text-muted">Review your selection before creating the requisition</p>
                        </div>
                        
                        <!-- Summary Card -->
                        <div class="card mb-4">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">📊 Requisition Summary</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <table class="table table-sm table-borderless">
                                            <tr><td class="text-muted">BOQ:</td><td><field name="boq_id" readonly="1"/></td></tr>
                                            <tr><td class="text-muted">Project:</td><td><field name="project_id" readonly="1"/></td></tr>
                                            <tr><td class="text-muted">Purpose:</td><td><field name="purpose" readonly="1"/></td></tr>
                                        </table>
                                    </div>
                                    <div class="col-md-6">
                                        <table class="table table-sm table-borderless">
                                            <tr><td class="text-muted">Required Date:</td><td><field name="required_date" readonly="1"/></td></tr>
                                            <tr><td class="text-muted">Priority:</td><td><field name="priority" readonly="1"/></td></tr>
                                        </table>
                                    </div>
                                </div>
                                
                                <div class="row text-center bg-light p-3 rounded">
                                    <div class="col-md-4">
                                        <h3 class="text-primary mb-0"><field name="selected_lines_count" readonly="1"/></h3>
                                        <small class="text-muted">Items</small>
                                    </div>
                                    <div class="col-md-4">
                                        <h3 class="text-info mb-0"><field name="selected_total_quantity" readonly="1"/></h3>
                                        <small class="text-muted">Quantity</small>
                                    </div>
                                    <div class="col-md-4">
                                        <h3 class="text-success mb-0"><field name="selected_total_cost" widget="monetary" readonly="1"/></h3>
                                        <small class="text-muted">Est. Cost</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Selected Items -->
                        <h5 class="mb-3">Selected Items (<field name="selected_lines_count" readonly="1"/>)</h5>
                        <field name="line_ids" mode="tree" domain="[('selected', '=', True)]" readonly="1">
                            <tree string="Selected Items"
                                  decoration-warning="quantity_status == 'exceed'">
                                <field name="product_id"/>
                                <field name="description"/>
                                <field name="category_id"/>
                                <field name="boq_quantity"/>
                                <field name="requested_quantity"/>
                                <field name="uom_id"/>
                                <field name="estimated_cost"/>
                                <field name="total_cost" sum="Total"/>
                                <field name="quantity_status"/>
                            </tree>
                        </field>
                    </sheet>
                    <footer>
                        <button name="action_go_back_to_selection" string="← Back" type="object" 
                                class="btn-secondary" icon="fa-arrow-left"/>
                        <button name="action_create_requisition" string="✓ Create Requisition" type="object" 
                                class="btn-success btn-lg" icon="fa-check"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </div>
            </form>
        </field>
    </record>

    <!-- BOQ Material Requisition Wizard Action -->
    <record id="action_boq_material_requisition_wizard" model="ir.actions.act_window">
        <field name="name">Create Material Requisition</field>
        <field name="res_model">boq.material.requisition.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_boq_id': active_id}</field>
    </record>

    <!-- Server Action: Select All -->
    <record id="action_server_select_all" model="ir.actions.server">
        <field name="name">Select All Filtered</field>
        <field name="model_id" ref="model_boq_material_requisition_wizard"/>
        <field name="binding_model_id" ref="model_boq_material_requisition_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_select_all()</field>
    </record>
</odoo>