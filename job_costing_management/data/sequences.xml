<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================ -->
    <!-- Sequences -->
    <!-- ============================================ -->
    
    <!-- Job Costing Sequence -->
    <record id="seq_job_costing" model="ir.sequence">
        <field name="name">Job Costing</field>
        <field name="code">job.costing</field>
        <field name="prefix">JOB/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
    
    <!-- Material Requisition Sequence -->
    <record id="seq_material_requisition" model="ir.sequence">
        <field name="name">Material Requisition</field>
        <field name="code">material.requisition</field>
        <field name="prefix">MR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
    
</odoo>
